# Backend configuration (copy to nutriscan_full_backup/backend/.env)
PROJECT_NAME=NutriScan
ENV=development
NUTRISCAN_DEBUG=false

# Local PostgreSQL; use your own local database credentials.
DATABASE_URL=postgresql+asyncpg://localhost:5432/nutriscan
DATABASE_URL_SYNC=postgresql+psycopg2://localhost:5432/nutriscan

# Create a fresh development keypair in backend/keys/; never reuse committed files.
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=keys/private_key.pem
JWT_PUBLIC_KEY_PATH=keys/public_key.pem
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_UPLOAD=20/hour

STORAGE_ROOT_DIR=storage/uploads
STORAGE_BACKEND=local
MAX_UPLOAD_SIZE_MB=8
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp
MIN_IMAGE_WIDTH_PX=300
MIN_IMAGE_HEIGHT_PX=300
SCAN_EXPIRATION_DAYS=90
DELETED_SCAN_RETENTION_DAYS=30

DATASET_ROOT=dataset
OPENFOODFACTS_DATASET_PATH=dataset/en.openfoodfacts.org.products.csv.gz
USDA_BRANDED_DATASET_PATH=dataset/FoodData_Central_branded_food_csv_2026-04-30/FoodData_Central_branded_food_csv_2026-04-30/branded_food.csv
USDA_SUPPORTING_DATASET_DIR=dataset/FoodData_Central_Supporting_Data_csv_2022-10-28
ALLERGENS_DATASET_PATH=dataset/allergens.json
INGREDIENT_ALIASES_DATASET_PATH=dataset/ingredient_aliases.json
INS_ADDITIVES_DATASET_PATH=dataset/ins_additives.json

OCR_TIMEOUT_SECONDS=30
OCR_MIN_CONFIDENCE=40
OCR_LANGUAGES=en
OCR_BLUR_THRESHOLD=100
OCR_TARGET_MAX_DIMENSION=1600
OCR_MODEL_DIR=storage/paddleocr
LOG_LEVEL=INFO
LOG_JSON=true
